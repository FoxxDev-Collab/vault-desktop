{
  "name": "vault-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:bun": "bun --hot src/index.tsx",
    "start": "NODE_ENV=production bun src/index.tsx",
    "build": "vite build",
    "build:bun": "bun run build.ts",
    "build:server": "bun build src/index.tsx --compile --outfile src-tauri/binaries/vault-server",
    "build:all": "bun run build && bun run build:server",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/standalone": "^7.28.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "^0.18.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "bun-plugin-tailwind": "^0.1.2",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.11.0",
    "mermaid": "^11.12.2",
    "pdfjs-dist": "^5.4.530",
    "react": "^19",
    "react-dom": "^19",
    "react-pdf": "^10.3.0",
    "recharts": "^3.7.0",
    "tailwindcss": "^4.1.11",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2.9.6",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "vite": "^7.3.1"
  }
}
